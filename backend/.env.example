# Copy to `.env` (never commit `.env`) or export these in your shell / hosting dashboard.

# --- Required ---
DB_URL=jdbc:mysql://localhost:3306/estatehub?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=estatehub_user
DB_PASSWORD=change-me
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# --- Optional (defaults shown) ---
JWT_EXPIRATION=86400000
FRONTEND_URL=http://localhost:5501,http://127.0.0.1:5501
FRONTEND_PUBLIC_URL=http://localhost:5501
CONTACT_PHONE=+919876543210
# CONTACT_WHATSAPP=+919876543210

# --- Seed accounts (development). If a password is left empty, a random one is generated
# --- and printed ONCE in the startup log. Set SEED_ENABLED=false in production.
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@trichyestates.local
SEED_ADMIN_PASSWORD=
SEED_AGENT_EMAIL=agent@trichyestates.local
SEED_AGENT_PASSWORD=

# --- Password reset e-mail ---
# Local dev only: prints reset links to the log instead of sending mail.
MAIL_LOG_RESET_LINKS=true
